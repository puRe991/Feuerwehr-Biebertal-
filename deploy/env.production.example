# Kopieren nach .env im deploy/-Ordner auf dem Server, dann alle Werte ausfuellen.
# Diese Datei niemals mit echten Secrets committen.

# Domain, unter der Directus erreichbar sein soll (DNS A-Record muss auf den Server zeigen)
CMS_DOMAIN=cms.feuerwehr-biebertal.de

# Domain der oeffentlichen Website, fuer CORS (Zugriff auf die Directus-API beim Build)
SITE_DOMAIN=www.feuerwehr-biebertal.de

# Directus Kern-Secrets, je einmalig generieren mit: openssl rand -hex 32
DIRECTUS_KEY=
DIRECTUS_SECRET=

# Erster Admin-Zugang. Passwort direkt nach dem ersten Login in Directus aendern.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres-Zugangsdaten (frei waehlbar, nur intern zwischen den Containern genutzt)
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=
