import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
---
<BaseLayout title="Jugendfeuerwehr" description="Jugendfeuerwehr Biebertal für Jugendliche von 10 bis 17 Jahren mit Übungen, Gemeinschaft und Übertritt in die Einsatzabteilung.">
<section class="mx-auto max-w-5xl px-4 py-16 prose-page"><h1 class="text-4xl font-black text-brand-navy">Jugendfeuerwehr 10 bis 17 Jahre</h1><p>Die Jugendfeuerwehr verbindet Technik, Teamarbeit und Gemeinschaft. Jugendliche lernen Geräte, Abläufe und Verantwortung altersgerecht kennen.</p><h2>Übungen, Ausflüge und Gemeinschaft</h2><p>Übungen finden nach Dienstplan statt. Dazu kommen Ausflüge, Wettbewerbe und gemeinsame Aktionen.</p><h2>Übertritt in die Einsatzabteilung</h2><p>Der Übergang erfolgt begleitet und mit Ausbildung. Niemand wird allein gelassen.</p><h2>Eltern-FAQ</h2><ul><li>Sicherheit und Betreuung stehen im Mittelpunkt.</li><li>Konkrete Zeiten und Treffpunkte werden lokal ergänzt.</li><li>Für Fragen steht die Jugendfeuerwehr als Ansprechpartner bereit.</li></ul><ContactForm /></section>
</BaseLayout>
