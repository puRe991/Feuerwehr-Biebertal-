---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ContactForm from '@/components/ContactForm.astro';
const faqs = [
  { question: 'Wer kann mitmachen?', answer: 'Menschen ab 17 Jahren, die in Biebertal wohnen, arbeiten oder einen engen Bezug zur Gemeinde haben.' },
  { question: 'Brauche ich Vorwissen?', answer: 'Nein. Du lernst Technik, Abläufe und Sicherheit Schritt für Schritt in der Feuerwehr.' },
  { question: 'Wie viel Zeit muss ich einplanen?', answer: 'Regelmäßige Übungen gehören dazu. Wie oft du kannst, besprichst du offen mit deinem Schutzbereich.' },
  { question: 'Muss ich besonders sportlich sein?', answer: 'Eine normale Grundfitness hilft. Noch wichtiger sind Verlässlichkeit, Teamgeist und Lernbereitschaft.' },
  { question: 'Kostet mich der Einstieg etwas?', answer: 'Persönliche Schutzausrüstung und Ausbildung werden gestellt.' }
];
---
<BaseLayout title="Mitmachen" description="Mitmachen bei der Feuerwehr Biebertal: klarer Einstieg für Quereinsteigerinnen, Quereinsteiger, Jugendliche und neue Einsatzkräfte.">
  <section class="bg-brand-navy px-4 py-20 text-white">
    <div class="mx-auto max-w-5xl">
      <p class="font-extrabold uppercase tracking-[.25em] text-brand-gold">Dein Ehrenamt in Biebertal</p>
      <h1 class="mt-4 text-5xl font-black">Mitmachen bei der Feuerwehr Biebertal</h1>
      <p class="mt-6 text-xl leading-9 text-slate-100">Du musst kein Profi sein, um anzufangen. Wenn du helfen willst, gern im Team arbeitest und zuverlässig bist, bist du bei uns richtig.</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_.9fr] lg:px-8">
    <div class="prose-page">
      <SectionHeader title="Warum Feuerwehr?" text="Weil Hilfe vor Ort Menschen braucht, die anpacken – tagsüber, abends, am Wochenende und immer freiwillig." />
      <h2>So läuft dein Einstieg</h2>
      <ul>
        <li>Du meldest dich unverbindlich und stellst deine Fragen.</li>
        <li>Du besuchst einen Übungsdienst in deinem Schutzbereich.</li>
        <li>Du lernst Ausrüstung, Team und Abläufe in Ruhe kennen.</li>
        <li>Du startest die Grundausbildung und wächst Schritt für Schritt hinein.</li>
        <li>Nach der nötigen Qualifikation fährst du mit zu Einsätzen.</li>
      </ul>

      <h2>Was du bei uns lernst</h2>
      <p>Du lernst Brände zu löschen, Menschen zu retten, Unfallsituationen abzusichern, Erste Hilfe zu leisten, per Funk zu kommunizieren und im Team sicher zu arbeiten. Fachbegriffe erklären wir dort, wo du sie brauchst.</p>

      <h2>Was du mitbringst</h2>
      <ul>
        <li>Zuverlässigkeit und Respekt im Team</li>
        <li>Bereitschaft zu Übungen und Ausbildung</li>
        <li>Ruhe, wenn andere Hilfe brauchen</li>
        <li>Offenheit für Menschen jeden Alters und Hintergrunds</li>
      </ul>

      <h2>Häufige Fragen</h2>
      <div class="grid gap-4">
        {faqs.map((faq) => <article class="rounded-2xl bg-white p-4 shadow-sm"><h3 class="font-black text-brand-navy">{faq.question}</h3><p class="mt-2">{faq.answer}</p></article>)}
      </div>
    </div>
    <ContactForm />
  </section>
</BaseLayout>
