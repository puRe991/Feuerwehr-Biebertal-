---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fahrzeuge } from '@/data/fahrzeuge';
export function getStaticPaths() { return fahrzeuge.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
---
<BaseLayout title={item.typ} description={`${item.typ} der Feuerwehr Biebertal.`}>
<section class="mx-auto max-w-5xl px-4 py-16"><a href="/technik/fahrzeuge/" class="font-bold text-brand-red">← Zurück</a><div class="mt-6 rounded-3xl bg-white p-8 shadow-soft"><div role="img" aria-label={item.bildAlt} class="mb-6 flex aspect-[16/9] items-center justify-center rounded-3xl bg-brand-navy text-white">Bild folgt</div><h1 class="text-4xl font-black text-brand-navy">{item.typ}</h1><dl class="mt-6 grid gap-4 md:grid-cols-2"><div><dt class="font-bold">Funkrufname</dt><dd>{item.funk}</dd></div><div><dt class="font-bold">Standort</dt><dd>{item.standort}</dd></div><div><dt class="font-bold">Einsatzzweck</dt><dd>{item.einsatzzweck}</dd></div><div><dt class="font-bold">Besatzung</dt><dd>{item.besatzung}</dd></div></dl><h2 class="mt-8 text-2xl font-black text-brand-navy">Besonderheiten</h2><ul class="mt-3 list-disc pl-5">{item.besonderheiten.map((b) => <li>{b}</li>)}</ul></div></section>
</BaseLayout>
