---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fahrzeuge } from '@/data/fahrzeuge';

const pages = [
  { path: '/', label: 'Startseite' },
  { path: '/aktuelles/', label: 'Aktuelles' },
  { path: '/aktuelles/einsatzberichte/', label: 'Einsatzberichte' },
  { path: '/aktuelles/presse/', label: 'Presse' },
  { path: '/aktuelles/veranstaltungen/', label: 'Veranstaltungen' },
  { path: '/mitmachen/', label: 'Mitmachen' },
  { path: '/mitmachen/einsatzabteilung/', label: 'Einsatzabteilung' },
  { path: '/mitmachen/jugendfeuerwehr/', label: 'Jugendfeuerwehr' },
  { path: '/mitmachen/kinderfeuerwehr/', label: 'Kinderfeuerwehr' },
  { path: '/mitmachen/quereinsteiger/', label: 'Quereinsteiger' },
  { path: '/mitmachen/faq/', label: 'FAQ' },
  { path: '/feuerwehr-biebertal/ueber-uns/', label: 'Über uns' },
  { path: '/feuerwehr-biebertal/schutzbereiche/', label: 'Schutzbereiche' },
  { path: '/feuerwehr-biebertal/standorte/', label: 'Standorte' },
  { path: '/feuerwehr-biebertal/leitung/', label: 'Leitung' },
  { path: '/feuerwehr-biebertal/feuerwehrvereine/', label: 'Feuerwehrvereine' },
  { path: '/technik/fahrzeuge/', label: 'Fahrzeuge' },
  ...fahrzeuge.map((fahrzeug) => ({ path: `/technik/fahrzeuge/${fahrzeug.slug}/`, label: `Fahrzeug: ${fahrzeug.funk}` })),
  { path: '/technik/drohne/', label: 'Drohne' },
  { path: '/technik/hygienekomponente/', label: 'Hygienekomponente' },
  { path: '/technik/katastrophenschutz/', label: 'Katastrophenschutz' },
  { path: '/buergerinfo/notruf-112/', label: 'Notruf 112' },
  { path: '/buergerinfo/verhalten-im-brandfall/', label: 'Verhalten im Brandfall' },
  { path: '/buergerinfo/rauchmelder/', label: 'Rauchmelder' },
  { path: '/buergerinfo/rettungsgasse/', label: 'Rettungsgasse' },
  { path: '/buergerinfo/warn-apps/', label: 'Warn-Apps' },
  { path: '/buergerinfo/unwetter/', label: 'Unwetter' },
  { path: '/buergerinfo/waldbrand/', label: 'Waldbrand' },
  { path: '/buergerinfo/hydranten-freihalten/', label: 'Hydranten freihalten' },
  { path: '/kontakt/', label: 'Kontakt' },
  { path: '/impressum/', label: 'Impressum' },
  { path: '/datenschutz/', label: 'Datenschutz' },
  { path: '/barrierefreiheit/', label: 'Barrierefreiheit' }
];
---
<BaseLayout title="Admin Dashboard" description="Dashboard zur lokalen Bearbeitung der Website-Inhalte und zum Erstellen lokaler Beiträge.">
  <section class="bg-brand-navy py-16 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-black uppercase tracking-[0.25em] text-brand-gold">Admin Dashboard</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_22rem] lg:items-end">
        <div>
          <h1 class="text-4xl font-black sm:text-5xl">Inhalte bearbeiten</h1>
          <p class="mt-4 max-w-3xl text-lg text-slate-200">
            Wähle eine Seite aus, aktiviere den visuellen Editor oder erstelle neue Meldungen und Einsatzberichte lokal im Browser.
          </p>
        </div>
        <div class="rounded-3xl bg-white/10 p-5 text-sm text-slate-100 ring-1 ring-white/15">
          <strong class="text-white">Wichtig:</strong> Die Änderungen landen im Local Storage dieses Browsers. Exportiere sie als Backup, wenn du sie auf ein anderes Gerät übertragen willst.
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8" data-admin-ignore>
    <div id="auth-warning" class="hidden rounded-2xl bg-red-50 p-5 text-red-800 ring-1 ring-red-100">
      Du bist nicht angemeldet. Du wirst zum Login weitergeleitet.
    </div>

    <div id="dashboard-content" class="grid gap-8 lg:grid-cols-[1fr_22rem]">
      <div class="space-y-8">
        <section class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <div class="grid gap-6 xl:grid-cols-[1fr_20rem] xl:items-start">
            <div>
              <p class="text-sm font-black uppercase tracking-[0.2em] text-brand-red">Neue Beiträge</p>
              <h2 class="mt-2 text-2xl font-black text-brand-navy">Meldung oder Einsatzbericht erstellen</h2>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Beiträge erscheinen sofort in diesem Browser auf den Aktuelles-Seiten. Für eine echte Veröffentlichung braucht es ein CMS oder einen Deployment-Prozess.
              </p>
            </div>
            <div class="rounded-2xl bg-brand-mist p-4 text-sm text-brand-navy">
              <strong>Datenschutz:</strong> Keine personenbezogenen Daten, Kennzeichen, Live-Informationen oder taktisch sensible Details eintragen.
            </div>
          </div>

          <form id="post-form" class="mt-6 grid gap-4" data-admin-ignore>
            <div class="grid gap-4 md:grid-cols-3">
              <div>
                <label class="block text-sm font-bold text-slate-800" for="post-type">Typ</label>
                <select id="post-type" name="type" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3">
                  <option value="news">Meldung</option>
                  <option value="incident">Einsatzbericht</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-bold text-slate-800" for="post-date">Datum</label>
                <input id="post-date" name="date" type="date" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" />
              </div>
              <div id="news-category-field">
                <label class="block text-sm font-bold text-slate-800" for="post-category">Kategorie</label>
                <select id="post-category" name="category" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3">
                  <option value="Hinweis">Hinweis</option>
                  <option value="Presse">Presse</option>
                  <option value="Veranstaltung">Veranstaltung</option>
                </select>
              </div>
              <div id="incident-location-field" class="hidden">
                <label class="block text-sm font-bold text-slate-800" for="post-location">Ortsteil</label>
                <input id="post-location" name="location" maxlength="80" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" placeholder="z. B. Rodheim-Bieber" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-bold text-slate-800" for="post-title">Titel / Einsatzart</label>
              <input id="post-title" name="title" required maxlength="120" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" placeholder="Kurzer, eindeutiger Titel" />
            </div>
            <div>
              <label class="block text-sm font-bold text-slate-800" for="post-teaser">Kurztext</label>
              <textarea id="post-teaser" name="teaser" required maxlength="520" rows="4" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" placeholder="Was ist wichtig? Sachlich und ohne sensible Details formulieren."></textarea>
            </div>
            <div id="incident-units-field" class="hidden">
              <label class="block text-sm font-bold text-slate-800" for="post-units">Einheiten (optional, kommagetrennt)</label>
              <input id="post-units" name="units" maxlength="180" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" placeholder="z. B. Schutzbereich Mitte, ELW" />
            </div>
            <p id="post-error" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" role="alert"></p>
            <div class="flex flex-wrap gap-3">
              <button class="rounded-xl bg-brand-red px-5 py-3 font-black text-white hover:bg-red-700" type="submit">Beitrag erstellen</button>
              <button id="clear-post-form" class="rounded-xl bg-slate-100 px-5 py-3 font-black text-slate-900" type="button">Formular leeren</button>
            </div>
          </form>

          <div class="mt-8">
            <h3 class="text-lg font-black text-brand-navy">Lokal erstellte Beiträge</h3>
            <div id="post-list" class="mt-4 grid gap-3"></div>
          </div>
        </section>

        <section>
          <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-2xl font-black text-brand-navy">Seiten</h2>
            <input id="page-filter" class="w-full rounded-xl border border-slate-300 px-4 py-3 sm:w-80" placeholder="Seiten filtern …" type="search" />
          </div>
          <div id="page-list" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {pages.map((page) => (
              <a class="admin-page-card rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-md" data-page-label={page.label.toLowerCase()} href={`${page.path}?adminEdit=1`}>
                <span class="block text-lg font-black text-brand-navy">{page.label}</span>
                <span class="mt-2 block text-sm text-slate-600">{page.path}</span>
                <span class="mt-4 inline-flex rounded-full bg-brand-mist px-3 py-1 text-xs font-black uppercase tracking-wide text-brand-red">Bearbeiten</span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="space-y-5">
        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h2 class="text-xl font-black text-brand-navy">Werkzeuge</h2>
          <div class="mt-5 grid gap-3">
            <button id="export-content" class="rounded-xl bg-brand-red px-4 py-3 font-black text-white" type="button">Inhalte exportieren</button>
            <label class="cursor-pointer rounded-xl bg-slate-100 px-4 py-3 text-center font-black text-slate-900">
              Inhalte importieren
              <input id="import-content" class="sr-only" type="file" accept="application/json" />
            </label>
            <button id="reset-content" class="rounded-xl border border-red-200 px-4 py-3 font-black text-red-700" type="button">Lokale Änderungen löschen</button>
            <button id="logout" class="rounded-xl bg-slate-900 px-4 py-3 font-black text-white" type="button">Ausloggen</button>
          </div>
          <p id="tool-message" class="mt-4 text-sm font-semibold text-slate-700" role="status"></p>
        </div>

        <div class="rounded-3xl bg-white p-6 text-sm text-slate-700 shadow-sm ring-1 ring-slate-200">
          <h2 class="text-xl font-black text-brand-navy">Produktive CMS-Optionen</h2>
          <ul class="mt-4 space-y-3 leading-6">
            <li><strong>Decap CMS:</strong> passt gut zur statischen Astro-Seite, weil Inhalte im Git-Workflow bleiben.</li>
            <li><strong>Directus:</strong> sinnvoll, wenn ein datenbankbasiertes Headless CMS mit Rollen, API und Medienverwaltung gebraucht wird.</li>
            <li><strong>Strapi:</strong> Alternative für ein selbst gehostetes Node.js-Headless-CMS mit frei modellierbaren Inhaltstypen.</li>
          </ul>
          <p class="mt-4 font-semibold text-brand-navy">Empfehlung: Für diese Website zuerst Decap CMS prüfen; bei mehreren Redakteuren und Rollenmodell Directus oder Strapi evaluieren.</p>
        </div>

        <div class="rounded-3xl bg-amber-50 p-6 text-sm text-amber-900 ring-1 ring-amber-100">
          <h2 class="font-black">Sicherheitsrisiko</h2>
          <p class="mt-2">Der Default-Login <strong>admin/admin</strong> ist nur für eine statische Demo geeignet. Nutze produktiv eine echte Authentifizierung mit Server, Rollenmodell und Passwort-Hashing.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  const AUTH_KEY = 'fb-admin-authenticated';
  const OVERRIDE_KEY = 'fb-admin-content-overrides-v1';
  const POST_KEY = 'fb-admin-posts-v1';
  const isAuthenticated = localStorage.getItem(AUTH_KEY) === 'true';
  const dashboard = document.querySelector('#dashboard-content');
  const warning = document.querySelector('#auth-warning');
  const message = document.querySelector('#tool-message');
  const postForm = document.querySelector('#post-form');
  const postType = document.querySelector('#post-type');
  const postList = document.querySelector('#post-list');
  const postError = document.querySelector('#post-error');
  const newsCategoryField = document.querySelector('#news-category-field');
  const incidentLocationField = document.querySelector('#incident-location-field');
  const incidentUnitsField = document.querySelector('#incident-units-field');

  if (!isAuthenticated) {
    dashboard?.classList.add('hidden');
    warning?.classList.remove('hidden');
    window.setTimeout(() => { window.location.href = '/admin/login/'; }, 900);
  }

  const setMessage = (text: string) => {
    if (message) message.textContent = text;
  };

  const sanitizeText = (value: FormDataEntryValue | null, maxLength = 520) => String(value || '').replace(/\s+/g, ' ').trim().slice(0, maxLength);

  const createPostId = () => {
    if ('crypto' in window && typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    return `post-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  };

  const getPosts = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(POST_KEY) || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch (error) {
      console.error(error);
      return [];
    }
  };

  const setPosts = (posts: unknown[]) => {
    localStorage.setItem(POST_KEY, JSON.stringify(posts));
  };

  const setPostError = (text = '') => {
    if (!postError) return;
    postError.textContent = text;
    postError.classList.toggle('hidden', !text);
  };

  const renderPosts = () => {
    if (!postList) return;
    const posts = getPosts();
    postList.textContent = '';
    if (!posts.length) {
      const empty = document.createElement('p');
      empty.className = 'rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-600';
      empty.textContent = 'Noch keine lokalen Beiträge erstellt.';
      postList.append(empty);
      return;
    }

    posts
      .slice()
      .sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')))
      .forEach((post) => {
        const card = document.createElement('article');
        card.className = 'rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200';

        const title = document.createElement('h4');
        title.className = 'font-black text-brand-navy';
        title.textContent = String(post.title || 'Ohne Titel');

        const meta = document.createElement('p');
        meta.className = 'mt-1 text-sm font-semibold text-slate-600';
        meta.textContent = post.type === 'incident'
          ? `${post.date || 'ohne Datum'} · Einsatzbericht · ${post.location || 'Ortsteil offen'}`
          : `${post.date || 'ohne Datum'} · ${post.category || 'Hinweis'}`;

        const teaser = document.createElement('p');
        teaser.className = 'mt-2 text-sm leading-6 text-slate-700';
        teaser.textContent = String(post.teaser || '');

        const actions = document.createElement('div');
        actions.className = 'mt-3 flex flex-wrap gap-2';

        const link = document.createElement('a');
        link.className = 'rounded-lg bg-white px-3 py-2 text-sm font-black text-brand-red ring-1 ring-red-100';
        link.href = post.type === 'incident' ? '/aktuelles/einsatzberichte/' : '/aktuelles/';
        link.textContent = 'Ansehen';

        const remove = document.createElement('button');
        remove.className = 'rounded-lg bg-white px-3 py-2 text-sm font-black text-slate-900 ring-1 ring-slate-200';
        remove.type = 'button';
        remove.textContent = 'Löschen';
        remove.addEventListener('click', () => {
          const confirmed = window.confirm('Diesen lokal erstellten Beitrag löschen?');
          if (!confirmed) return;
          setPosts(getPosts().filter((item) => item.id !== post.id));
          renderPosts();
          setMessage('Beitrag gelöscht.');
        });

        actions.append(link, remove);
        card.append(title, meta, teaser, actions);
        postList.append(card);
      });
  };

  const updatePostFormMode = () => {
    const isIncident = postType instanceof HTMLSelectElement && postType.value === 'incident';
    newsCategoryField?.classList.toggle('hidden', isIncident);
    incidentLocationField?.classList.toggle('hidden', !isIncident);
    incidentUnitsField?.classList.toggle('hidden', !isIncident);
  };

  document.querySelector('#page-filter')?.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    const query = target.value.toLowerCase().trim();
    document.querySelectorAll('.admin-page-card').forEach((card) => {
      const label = card.getAttribute('data-page-label') || '';
      card.classList.toggle('hidden', Boolean(query) && !label.includes(query));
    });
  });

  document.querySelector('#export-content')?.addEventListener('click', () => {
    const content = JSON.stringify({
      version: 2,
      exportedAt: new Date().toISOString(),
      overrides: JSON.parse(localStorage.getItem(OVERRIDE_KEY) || '{}'),
      posts: getPosts()
    }, null, 2);
    const blob = new Blob([content], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `feuerwehr-biebertal-content-${new Date().toISOString().slice(0, 10)}.json`;
    link.click();
    URL.revokeObjectURL(url);
    setMessage('Export mit Textänderungen und Beiträgen erstellt.');
  });

  document.querySelector('#import-content')?.addEventListener('change', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    const [file] = target.files || [];
    if (!file) return;
    try {
      const text = await file.text();
      const parsed = JSON.parse(text);
      if (parsed && typeof parsed === 'object' && 'version' in parsed) {
        localStorage.setItem(OVERRIDE_KEY, JSON.stringify(parsed.overrides || {}));
        localStorage.setItem(POST_KEY, JSON.stringify(Array.isArray(parsed.posts) ? parsed.posts : []));
      } else {
        localStorage.setItem(OVERRIDE_KEY, text);
      }
      renderPosts();
      setMessage('Import erfolgreich. Lade die betroffenen Seiten neu.');
    } catch (error) {
      console.error(error);
      setMessage('Import fehlgeschlagen: Die Datei enthält kein gültiges JSON.');
    }
  });

  document.querySelector('#reset-content')?.addEventListener('click', () => {
    const confirmed = window.confirm('Alle lokal gespeicherten Inhaltsänderungen wirklich löschen?');
    if (!confirmed) return;
    localStorage.removeItem(OVERRIDE_KEY);
    localStorage.removeItem(POST_KEY);
    renderPosts();
    setMessage('Lokale Inhaltsänderungen und Beiträge gelöscht.');
  });

  postType?.addEventListener('change', updatePostFormMode);

  document.querySelector('#clear-post-form')?.addEventListener('click', () => {
    if (postForm instanceof HTMLFormElement) postForm.reset();
    updatePostFormMode();
    setPostError();
  });

  postForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(postForm instanceof HTMLFormElement)) return;
    const data = new FormData(postForm);
    const type = data.get('type') === 'incident' ? 'incident' : 'news';
    const title = sanitizeText(data.get('title'), 120);
    const teaser = sanitizeText(data.get('teaser'), 520);
    const date = sanitizeText(data.get('date'), 10);
    const dateTime = new Date(`${date}T00:00:00`);

    if (!title || !teaser || !date || Number.isNaN(dateTime.getTime())) {
      setPostError('Bitte Titel, Datum und Kurztext ausfüllen.');
      return;
    }

    const post = type === 'incident'
      ? {
          id: createPostId(),
          type,
          date,
          title,
          teaser,
          location: sanitizeText(data.get('location'), 80) || 'Biebertal',
          units: sanitizeText(data.get('units'), 180)
        }
      : {
          id: createPostId(),
          type,
          date,
          title,
          teaser,
          category: sanitizeText(data.get('category'), 20) || 'Hinweis'
        };

    setPosts([post, ...getPosts()]);
    postForm.reset();
    updatePostFormMode();
    setPostError();
    renderPosts();
    setMessage('Beitrag erstellt. Er ist lokal auf den Aktuelles-Seiten sichtbar.');
  });

  updatePostFormMode();
  renderPosts();

  document.querySelector('#logout')?.addEventListener('click', () => {
    localStorage.removeItem(AUTH_KEY);
    window.location.href = '/admin/login/';
  });
</script>
