---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cmsAdminUrl, hasCmsAdmin, LOCAL_DIRECTUS_URL, usesLocalCmsFallback } from '@/lib/cmsAdmin';
---
<BaseLayout title={hasCmsAdmin ? 'CMS-Login' : 'CMS-Login nicht konfiguriert'} description="Sicherer Zugang zum redaktionellen CMS der Feuerwehr Biebertal." noindex={true}>
  <section class="bg-brand-mist py-16">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
        <p class="text-sm font-black uppercase tracking-[0.25em] text-brand-red">CMS</p>
        <h1 class="mt-3 text-3xl font-black text-brand-navy">{hasCmsAdmin ? 'Weiter zum CMS-Login' : 'CMS-Login nicht konfiguriert'}</h1>
        {hasCmsAdmin && cmsAdminUrl ? (
          <>
            <p class="mt-3 leading-7 text-slate-700">
              Die Website betreibt bewusst keinen eigenen Admin-Login. Redakteurinnen und Redakteure melden sich direkt im abgesicherten CMS an. Nutzen Sie dafür den folgenden Link.
            </p>
            {usesLocalCmsFallback && (
              <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950">
                <p class="font-black">Lokaler Debug-Modus: Directus muss separat laufen.</p>
                <p class="mt-2">Wenn der Browser "localhost hat die Verbindung abgelehnt" meldet, ist unter <code class="rounded bg-white px-1 py-0.5">{LOCAL_DIRECTUS_URL}</code> kein CMS gestartet.</p>
                <p class="mt-2">Starte das lokale CMS ohne Docker mit <code class="rounded bg-white px-1 py-0.5">npm run cms:dev</code> und öffne danach den Login erneut.</p>
              </div>
            )}
            <a class="mt-6 inline-flex rounded-xl bg-brand-red px-5 py-3 font-black text-white hover:bg-red-700" href={cmsAdminUrl} rel="noopener noreferrer">CMS öffnen</a>
          </>
        ) : (
          <>
            <p class="mt-3 leading-7 text-slate-700">
              Für diesen Build wurde keine CMS-Admin-URL gesetzt. Das ist für eine statische Website sicherer als ein lokaler Demo-Login, muss vor dem redaktionellen Betrieb aber bewusst konfiguriert werden.
            </p>
            <ul class="mt-5 list-disc space-y-2 pl-5 leading-7 text-slate-700">
              <li>Setzen Sie <code class="rounded bg-slate-100 px-1 py-0.5">PUBLIC_CMS_ADMIN_URL</code> auf die interne Directus-Login-Adresse.</li>
              <li>Nutzen Sie CMS-Rollen, Zwei-Faktor-Authentifizierung und ein Freigabefeld für veröffentlichte Inhalte.</li>
              <li>Speichern Sie API-Tokens nur serverseitig und nie als <code class="rounded bg-slate-100 px-1 py-0.5">PUBLIC_</code>-Variable.</li>
            </ul>
            <a class="mt-6 inline-flex rounded-xl bg-brand-red px-5 py-3 font-black text-white hover:bg-red-700" href="/">Zur Startseite</a>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
