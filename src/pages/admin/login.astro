---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Admin Login" description="Login für das lokale Admin-Dashboard der Feuerwehr Biebertal.">
  <section class="bg-brand-mist py-16">
    <div class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
        <p class="text-sm font-black uppercase tracking-[0.25em] text-brand-red">Admin</p>
        <h1 class="mt-3 text-3xl font-black text-brand-navy">Anmelden</h1>
        <p class="mt-3 text-slate-700">
          Standard-Zugang: <strong>admin</strong> / <strong>admin</strong>. Ändere diese Daten vor einer echten Veröffentlichung.
        </p>

        <form id="admin-login-form" class="mt-8 space-y-5" data-admin-ignore>
          <div>
            <label class="block text-sm font-bold text-slate-800" for="username">Benutzername</label>
            <input id="username" name="username" autocomplete="username" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-red-100" />
          </div>
          <div>
            <label class="block text-sm font-bold text-slate-800" for="password">Passwort</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 focus:border-brand-red focus:outline-none focus:ring-2 focus:ring-red-100" />
          </div>
          <p id="login-error" class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" role="alert"></p>
          <button class="w-full rounded-xl bg-brand-red px-5 py-3 font-black text-white hover:bg-red-700" type="submit">Einloggen</button>
        </form>

        <div class="mt-6 rounded-2xl bg-amber-50 p-4 text-sm text-amber-900">
          <strong>Sicherheitshinweis:</strong> Dieser Login schützt Inhalte nur im Browser. Für produktive Mehrbenutzer-Bearbeitung brauchst du ein serverseitiges CMS mit Rollen, Passwort-Hashing und Backups.
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector('#admin-login-form');
  const errorBox = document.querySelector('#login-error');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const username = String(data.get('username') || '').trim();
    const password = String(data.get('password') || '');

    if (username === 'admin' && password === 'admin') {
      localStorage.setItem('fb-admin-authenticated', 'true');
      window.location.href = '/admin/';
      return;
    }

    if (errorBox) {
      errorBox.textContent = 'Login fehlgeschlagen. Bitte Benutzername und Passwort prüfen.';
      errorBox.classList.remove('hidden');
    }
  });
</script>
