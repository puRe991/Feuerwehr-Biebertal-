---
const nav = Astro.props.nav;
---
<details class="relative lg:hidden">
  <summary class="cursor-pointer list-none rounded-full border border-white/15 bg-white/10 px-4 py-2 font-bold text-white marker:content-none">Menü</summary>
  <div class="absolute right-0 top-14 z-50 w-[min(22rem,calc(100vw-2rem))] rounded-[1.5rem] border border-slate-200 bg-white p-3 text-brand-navy shadow-2xl">
    <nav aria-label="Mobile Navigation" class="grid gap-1">
      {nav.map((item: { href: string; label: string }) => <a class="rounded-2xl px-4 py-3 font-extrabold transition hover:bg-brand-mist" href={item.href}>{item.label}</a>)}
      <a class="mt-2 rounded-2xl bg-brand-red px-4 py-3 text-center font-black text-white" href="tel:112">Notfall 112</a>
    </nav>
  </div>
</details>
