---
import type { Schutzbereich } from '@/data/schutzbereiche';
interface Props { item: Schutzbereich; }
const { item } = Astro.props;
---
<article class="flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-soft">
  <p class="text-sm font-extrabold uppercase tracking-[.18em] text-brand-red">Schutzbereich</p>
  <h3 class="mt-2 text-2xl font-black text-brand-navy">{item.name}</h3>
  <p class="mt-3 leading-7 text-slate-600">{item.beschreibung}</p>
  <dl class="mt-5 space-y-3 text-sm">
    <div><dt class="font-bold text-brand-navy">Ortsteile</dt><dd class="text-slate-600">{item.ortsteile.join(', ')}</dd></div>
    <div><dt class="font-bold text-brand-navy">Fahrzeuge</dt><dd class="text-slate-600">{item.fahrzeuge.join(', ')}</dd></div>
  </dl>
  <a href={`/feuerwehr-biebertal/schutzbereiche/#${item.slug}`} class="mt-auto pt-5 font-extrabold text-brand-red underline-offset-4 hover:underline">Details und Kontakt</a>
</article>
