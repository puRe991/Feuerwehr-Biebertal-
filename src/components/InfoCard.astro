---
interface Props { title: string; text: string; href?: string; label?: string; }
const { title, text, href, label = 'Mehr erfahren' } = Astro.props;
---
<article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft">
  <h3 class="text-xl font-extrabold text-brand-navy">{title}</h3>
  <p class="mt-3 leading-7 text-slate-600">{text}</p>
  {href && <a class="mt-5 inline-flex font-bold text-brand-red underline-offset-4 hover:underline" href={href}>{label}</a>}
</article>
