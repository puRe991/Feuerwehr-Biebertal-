---
interface Props { title: string; text: string; href?: string; label?: string; accent?: string; }
const { title, text, href, label = 'Mehr erfahren', accent = 'Information' } = Astro.props;
---
<article class="card-interactive group h-full p-6 sm:p-7">
  <div class="mb-5 h-1.5 w-16 rounded-full bg-brand-red transition group-hover:w-24"></div>
  <p class="text-xs font-black uppercase tracking-[.2em] text-brand-red">{accent}</p>
  <h3 class="mt-3 text-2xl font-black tracking-tight text-brand-navy">{title}</h3>
  <p class="mt-4 leading-7 text-slate-600">{text}</p>
  {href && <a class="mt-6 inline-flex items-center gap-2 font-extrabold text-brand-red underline-offset-4 hover:underline" href={href}>{label}<span aria-hidden="true">→</span></a>}
</article>
