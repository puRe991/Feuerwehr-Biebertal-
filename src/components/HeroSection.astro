---
import CTAButton from './CTAButton.astro';
interface Props { title: string; subtitle: string; }
const { title, subtitle } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-brand-navy text-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_18%,rgba(215,25,32,.42),transparent_24rem),radial-gradient(circle_at_88%_14%,rgba(247,183,51,.18),transparent_20rem),linear-gradient(135deg,#061326_0%,#071a33_45%,#102f57_100%)]"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-slate-50 to-transparent"></div>

  <div class="container-page grid items-center gap-12 py-16 lg:grid-cols-[1.02fr_.98fr] lg:min-h-[780px] lg:py-20">
    <div class="max-w-3xl">
      <div class="mb-8 flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-extrabold uppercase tracking-[.22em] text-brand-gold backdrop-blur">Freiwillige Feuerwehr</span>
        <span class="rounded-full border border-white/15 px-4 py-2 text-xs font-bold text-slate-200">24/7 ehrenamtlich einsatzbereit</span>
      </div>
      <div class="red-rule">
        <h1 class="text-5xl font-black tracking-[-0.055em] text-white sm:text-6xl lg:text-7xl xl:text-8xl">{title}</h1>
        <p class="mt-6 max-w-2xl text-xl font-semibold leading-9 text-slate-100 sm:text-2xl">{subtitle}</p>
      </div>
      <p class="mt-7 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">Drei Schutzbereiche. Moderne Technik. Klare Informationen für Bürgerinnen und Bürger. Und ein Einstieg, der ohne Vorwissen möglich ist.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <CTAButton href="/mitmachen/">Mitmachen</CTAButton>
        <CTAButton href="/mitmachen/jugendfeuerwehr/" variant="light">Jugendfeuerwehr</CTAButton>
        <CTAButton href="/aktuelles/" variant="ghost">Aktuelles</CTAButton>
        <CTAButton href="/kontakt/" variant="ghost">Kontakt aufnehmen</CTAButton>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      <div class="absolute -inset-4 rounded-[2.5rem] bg-brand-red/25 blur-2xl"></div>
      <figure class="relative overflow-hidden rounded-[2rem] border border-white/15 bg-slate-950 shadow-2xl shadow-black/35">
        <div role="img" aria-label="Platzhalter für ein Einsatz- oder Teamfoto der Feuerwehr Biebertal" class="aspect-[4/5] min-h-[28rem] bg-[linear-gradient(160deg,rgba(7,26,51,.18),rgba(7,26,51,.92)),radial-gradient(circle_at_72%_24%,rgba(247,183,51,.38),transparent_10rem),linear-gradient(135deg,#20344f,#0f172a_48%,#d71920_140%)] sm:aspect-[5/4] lg:aspect-[4/5]">
          <div class="flex h-full flex-col justify-between p-6 sm:p-8">
            <div class="ml-auto w-fit rounded-full bg-white/12 px-4 py-2 text-sm font-black backdrop-blur">Foto folgt</div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/15 bg-white/12 p-4 backdrop-blur"><p class="text-3xl font-black">3</p><p class="text-sm text-slate-200">Schutzbereiche</p></div>
              <div class="rounded-2xl border border-white/15 bg-white/12 p-4 backdrop-blur"><p class="text-3xl font-black">112</p><p class="text-sm text-slate-200">bei akuter Gefahr</p></div>
            </div>
          </div>
        </div>
        <figcaption class="border-t border-white/10 bg-white/10 px-6 py-4 text-sm text-slate-200">Platzhalter für ein freigegebenes Team- oder Einsatzfoto. Keine Live-Einsatzbilder, keine identifizierbaren Betroffenen.</figcaption>
      </figure>
    </div>
  </div>
</section>
