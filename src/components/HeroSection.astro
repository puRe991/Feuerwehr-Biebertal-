---
import CTAButton from './CTAButton.astro';
interface Props { title: string; subtitle: string; }
const { title, subtitle } = Astro.props;
---
<section class="relative overflow-hidden bg-brand-navy text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(215,25,32,.35),transparent_30%),linear-gradient(135deg,#071a33,#0d2b52)]"></div>
  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_.9fr] lg:px-8 lg:py-28">
    <div>
      <p class="font-extrabold uppercase tracking-[.25em] text-brand-gold">Freiwillige Feuerwehr</p>
      <h1 class="mt-4 text-5xl font-black tracking-tight md:text-7xl">{title}</h1>
      <p class="mt-6 max-w-2xl text-xl leading-9 text-slate-100">{subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3"><CTAButton href="/mitmachen/">Mitmachen</CTAButton><CTAButton href="/mitmachen/jugendfeuerwehr/" variant="light">Jugendfeuerwehr</CTAButton><CTAButton href="/aktuelles/" variant="secondary">Aktuelles</CTAButton><CTAButton href="/kontakt/" variant="light">Kontakt aufnehmen</CTAButton></div>
    </div>
    <div class="rounded-[2rem] border border-white/15 bg-white/10 p-6 shadow-soft backdrop-blur"><p class="text-sm font-bold uppercase tracking-[.18em] text-brand-gold">Hinweis</p><p class="mt-4 text-2xl font-black">Keine Live-Einsatzmeldungen.</p><p class="mt-3 leading-7 text-slate-100">Informationen erscheinen erst nach Freigabe. Im Notfall immer sofort 112 wählen.</p></div>
  </div>
</section>
