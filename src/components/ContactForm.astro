---
const contactEmail = 'kontakt@feuerwehr-biebertal.de';
---
<section
  class="grid gap-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-soft"
  aria-describedby="form-hinweis"
  aria-labelledby="contact-form-heading"
>
  <div class="grid gap-2">
    <h2 id="contact-form-heading" class="text-xl font-black text-brand-navy">Kontakt aufnehmen</h2>
    <p id="form-hinweis" class="text-sm text-slate-600">
      Senden Sie Ihre Anfrage datensparsam per E-Mail. Das Formular öffnet Ihr E-Mail-Programm und überträgt keine Daten an diese Website.
      Im Notfall wählen Sie immer <strong>112</strong>.
    </p>
  </div>

  <form id="contact-form" class="grid gap-5" data-contact-email={contactEmail} novalidate>
    <label class="grid gap-2 font-bold text-brand-navy">
      Name
      <input id="contact-name" name="name" required autocomplete="name" maxlength="120" class="rounded-xl border border-slate-300 px-4 py-3 font-normal" />
    </label>
    <label class="grid gap-2 font-bold text-brand-navy">
      E-Mail
      <input id="contact-email" name="email" required type="email" autocomplete="email" maxlength="160" class="rounded-xl border border-slate-300 px-4 py-3 font-normal" />
    </label>
    <label class="grid gap-2 font-bold text-brand-navy">
      Thema
      <select id="contact-topic" name="topic" class="rounded-xl border border-slate-300 px-4 py-3 font-normal">
        <option>Mitmachen</option>
        <option>Einsatzabteilung</option>
        <option>Jugendfeuerwehr</option>
        <option>Kinderfeuerwehr</option>
        <option>Bürgerinfo</option>
        <option>Allgemeine Anfrage</option>
      </select>
    </label>
    <label class="grid gap-2 font-bold text-brand-navy">
      Nachricht
      <textarea id="contact-message" name="message" required rows="6" maxlength="2500" class="rounded-xl border border-slate-300 px-4 py-3 font-normal"></textarea>
    </label>
    <label class="flex gap-3 text-sm text-slate-700">
      <input id="contact-privacy" required type="checkbox" class="mt-1 size-4" />
      Ich habe den Datenschutzhinweis gelesen und möchte kontaktiert werden.
    </label>
    <button
      class="rounded-full bg-brand-red px-6 py-3 font-black text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-200"
      type="submit"
      aria-describedby="form-status"
    >
      E-Mail vorbereiten
    </button>
    <p id="form-status" class="text-sm font-semibold text-slate-700" role="status">
      Alternativ schreiben Sie direkt an <a class="font-black text-brand-red underline" href={`mailto:${contactEmail}`}>{contactEmail}</a>.
    </p>
  </form>
</section>

<script>
  const form = document.querySelector('#contact-form');
  const status = document.querySelector('#form-status');
  const normalize = (value: FormDataEntryValue | null, maxLength: number) => String(value || '').replace(/[\u0000-\u001F\u007F]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, maxLength);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const recipient = form.dataset.contactEmail || 'kontakt@feuerwehr-biebertal.de';
    const name = normalize(data.get('name'), 120);
    const email = normalize(data.get('email'), 160);
    const topic = normalize(data.get('topic'), 80);
    const message = normalize(data.get('message'), 2500);
    const subject = encodeURIComponent(`Kontaktanfrage Feuerwehr Biebertal: ${topic}`);
    const body = encodeURIComponent(`Name: ${name}\nE-Mail: ${email}\nThema: ${topic}\n\nNachricht:\n${message}\n\nHinweis: Diese Nachricht wurde lokal im Browser vorbereitet.`);

    window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
    if (status) status.textContent = 'Ihr E-Mail-Programm wurde geöffnet. Bitte prüfen und senden Sie die Nachricht dort ab.';
  });
</script>
