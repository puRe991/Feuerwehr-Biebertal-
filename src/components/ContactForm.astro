<section
  class="grid gap-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-soft"
  aria-describedby="form-hinweis"
  aria-labelledby="contact-form-heading"
>
  <div class="grid gap-2">
    <h2 id="contact-form-heading" class="text-xl font-black text-brand-navy">Kontakt aufnehmen</h2>
    <p id="form-hinweis" class="text-sm text-slate-600">
      Das Formular ist noch nicht aktiv. Für den Betrieb braucht es eine datensparsame Verarbeitung mit Spam-Schutz. Bitte nutzen Sie bis dahin die direkten Kontaktwege auf der Kontaktseite.
    </p>
  </div>

  <div role="form" aria-describedby="form-hinweis form-status" class="grid gap-5">
    <label class="grid gap-2 font-bold text-brand-navy">
      Name
      <input required autocomplete="name" class="rounded-xl border border-slate-300 px-4 py-3 font-normal" />
    </label>
    <label class="grid gap-2 font-bold text-brand-navy">
      E-Mail
      <input required type="email" autocomplete="email" class="rounded-xl border border-slate-300 px-4 py-3 font-normal" />
    </label>
    <label class="grid gap-2 font-bold text-brand-navy">
      Thema
      <select class="rounded-xl border border-slate-300 px-4 py-3 font-normal">
        <option>Mitmachen</option>
        <option>Einsatzabteilung</option>
        <option>Jugendfeuerwehr</option>
        <option>Kinderfeuerwehr</option>
        <option>Bürgerinfo</option>
        <option>Allgemeine Anfrage</option>
      </select>
    </label>
    <label class="grid gap-2 font-bold text-brand-navy">
      Nachricht
      <textarea required rows="6" class="rounded-xl border border-slate-300 px-4 py-3 font-normal"></textarea>
    </label>
    <label class="flex gap-3 text-sm text-slate-700">
      <input required type="checkbox" class="mt-1 size-4" />
      Ich habe den Datenschutzhinweis gelesen und möchte kontaktiert werden.
    </label>
    <button
      type="button"
      disabled
      class="cursor-not-allowed rounded-full bg-slate-400 px-6 py-3 font-black text-white"
      aria-describedby="form-status"
    >
      Absenden aktuell deaktiviert
    </button>
    <p id="form-status" class="text-sm font-semibold text-slate-700">
      Es werden aktuell keine personenbezogenen Daten über dieses Formular übertragen.
    </p>
  </div>
</section>
