---
interface Props { eyebrow?: string; title: string; text?: string; align?: 'center' | 'left'; }
const { eyebrow, title, text, align = 'center' } = Astro.props;
---
<div class:list={["mb-10 max-w-3xl", align === 'center' ? 'mx-auto text-center' : '']}> 
  {eyebrow && <p class="text-sm font-extrabold uppercase tracking-[.24em] text-brand-red">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-black tracking-[-0.035em] text-brand-navy md:text-5xl">{title}</h2>
  {text && <p class="mt-5 text-lg leading-8 text-slate-600">{text}</p>}
</div>
