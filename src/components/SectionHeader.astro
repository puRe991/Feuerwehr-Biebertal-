---
interface Props { eyebrow?: string; title: string; text?: string; }
const { eyebrow, title, text } = Astro.props;
---
<div class="mx-auto mb-8 max-w-3xl text-center">
  {eyebrow && <p class="text-sm font-extrabold uppercase tracking-[.2em] text-brand-red">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-black tracking-tight text-brand-navy md:text-4xl">{title}</h2>
  {text && <p class="mt-4 text-lg leading-8 text-slate-600">{text}</p>}
</div>
