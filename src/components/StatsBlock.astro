---
const stats = Astro.props.stats ?? [
  { value: 'ca. 100', label: 'Einsätze im Jahr' },
  { value: 'ca. 150', label: 'aktive Einsatzkräfte' },
  { value: '16', label: 'Fahrzeuge' }
];
---
<div class="grid gap-4 sm:grid-cols-3">
  {stats.map((stat: { value: string; label: string }) => (
    <div class="group rounded-[1.75rem] border border-slate-200 bg-white p-6 text-center shadow-soft transition duration-300 motion-safe:hover:-translate-y-1 hover:shadow-2xl">
      <p class="text-4xl font-black tracking-tight text-brand-red sm:text-5xl">{stat.value}</p>
      <p class="mt-3 font-black text-brand-navy">{stat.label}</p>
    </div>
  ))}
</div>
