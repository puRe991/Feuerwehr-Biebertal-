---
import type { NewsItem } from '@/data/news';
interface Props { item: NewsItem; }
const { item } = Astro.props;
const date = new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium' }).format(new Date(item.datum));
---
<article class="card-interactive group overflow-hidden">
  <div class="h-1.5 bg-brand-red"></div>
  <div class="p-6">
    <p class="text-sm font-bold text-slate-500">{date} · {item.kategorie}</p>
    <h3 class="mt-3 text-xl font-black tracking-tight text-brand-navy group-hover:text-brand-red">{item.titel}</h3>
    <p class="mt-3 leading-7 text-slate-600">{item.teaser}</p>
    <a href="/aktuelles/" class="mt-5 inline-flex font-extrabold text-brand-red underline-offset-4 hover:underline">Zur Meldung →</a>
  </div>
</article>
