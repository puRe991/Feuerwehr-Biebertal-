---
import type { Einsatzbericht } from '@/data/einsatzberichte';
interface Props { item: Einsatzbericht; }
const { item } = Astro.props;
const date = new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium' }).format(new Date(item.datum));
---
<article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-soft">
  <p class="text-sm font-bold text-slate-500">{date} · {item.ortsteil}</p>
  <h3 class="mt-2 text-xl font-black text-brand-navy">{item.einsatzart}</h3>
  <p class="mt-3 leading-7 text-slate-600">{item.kurzbeschreibung}</p>
  <p class="mt-4 rounded-2xl bg-brand-mist p-4 text-sm font-semibold text-brand-navy">{item.datenschutzHinweis}</p>
</article>
