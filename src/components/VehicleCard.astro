---
import type { Fahrzeug } from '@/data/fahrzeuge';
interface Props { item: Fahrzeug; }
const { item } = Astro.props;
---
<article class="card-interactive group overflow-hidden">
  <div role="img" aria-label={item.bildAlt} class="relative flex aspect-[16/10] items-end overflow-hidden bg-[linear-gradient(145deg,#0d2b52,#071a33_58%,#d71920_150%)] p-5 text-white">
    <div class="absolute inset-0 opacity-30 [background-image:linear-gradient(90deg,rgba(255,255,255,.16)_1px,transparent_1px),linear-gradient(rgba(255,255,255,.12)_1px,transparent_1px)] [background-size:34px_34px]"></div>
    <span class="relative rounded-full bg-white/12 px-4 py-2 text-sm font-black backdrop-blur">Fahrzeugbild folgt</span>
  </div>
  <div class="p-6">
    <p class="text-xs font-extrabold uppercase tracking-[.2em] text-brand-red">{item.funk}</p>
    <h3 class="mt-3 text-2xl font-black tracking-tight text-brand-navy">{item.typ}</h3>
    <p class="mt-3 leading-7 text-slate-600">{item.einsatzzweck}</p>
    <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
      <div class="rounded-2xl bg-brand-mist p-3"><dt class="font-black text-brand-navy">Standort</dt><dd class="mt-1 text-slate-600">{item.standort}</dd></div>
      <div class="rounded-2xl bg-brand-mist p-3"><dt class="font-black text-brand-navy">Besatzung</dt><dd class="mt-1 text-slate-600">{item.besatzung}</dd></div>
    </dl>
    <a href={`/technik/fahrzeuge/${item.slug}/`} class="mt-6 inline-flex font-extrabold text-brand-red underline-offset-4 hover:underline">Detailseite →</a>
  </div>
</article>
