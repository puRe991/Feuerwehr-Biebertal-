---
import type { Fahrzeug } from '@/data/fahrzeuge';
interface Props { item: Fahrzeug; }
const { item } = Astro.props;
---
<article class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-soft">
  <div role="img" aria-label={item.bildAlt} class="flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-brand-blue to-brand-navy text-sm font-bold text-white">Bild folgt</div>
  <div class="p-6">
    <p class="text-sm font-extrabold uppercase tracking-[.18em] text-brand-red">{item.funk}</p>
    <h3 class="mt-2 text-xl font-black text-brand-navy">{item.typ}</h3>
    <p class="mt-3 text-slate-600">{item.einsatzzweck}</p>
    <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2"><div><dt class="font-bold">Standort</dt><dd>{item.standort}</dd></div><div><dt class="font-bold">Besatzung</dt><dd>{item.besatzung}</dd></div></dl>
    <a href={`/technik/fahrzeuge/${item.slug}/`} class="mt-5 inline-flex font-extrabold text-brand-red underline-offset-4 hover:underline">Detailseite</a>
  </div>
</article>
