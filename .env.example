# Public Directus project URL, e.g. https://cms.example.org
PUBLIC_DIRECTUS_URL=

# Public CMS login URL for editors. Defaults to PUBLIC_DIRECTUS_URL if empty.
PUBLIC_CMS_ADMIN_URL=

# Optional server-side token for private Directus collections. Never expose this as PUBLIC_*.
DIRECTUS_TOKEN=

# Set to false to force local fallback data from src/data/* during builds.
ENABLE_DIRECTUS=true
